# ============================================================
# SENTINEL AI - Environment Configuration
# Copy to .env and adjust. Defaults work out-of-the-box.
# ============================================================

# --- Server ------------------------------------------------------------------
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_DEBUG=true

# --- Database (SQLite by default; swap to PostgreSQL anytime) ----------------
# SQLite:
DATABASE_URL=sqlite:///./database/sentinel.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://sentinel:secret@localhost:5432/sentinel

# --- Local AI (Ollama) -------------------------------------------------------
# Leave empty to auto-detect at localhost:11434
OLLAMA_HOST=http://127.0.0.1:11434
# Preferred local model. Anything from the llama/mistral/gemma family works:
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Fall back to template-based analysis if Ollama is unreachable:
OLLAMA_TIMEOUT=8

# --- OSINT / external API keys (ALL OPTIONAL) --------------------------------
# The platform works without keys using Wikipedia, GDELT and simulated data.
GDELT_ENABLED=true
# NewsAPI (optional, free tier): https://newsapi.org
NEWSAPI_KEY=
# OpenCage for reverse-geocoding location clues (optional)
OPENCAGE_API_KEY=

# --- Feature toggles ---------------------------------------------------------
SIMULATION_MODE=auto       # auto | on | off
VISION_ENABLED=true
OSINT_ENABLED=true
CACHE_AGE_HOURS=48
